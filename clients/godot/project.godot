; Open with Godot 4.5 or newer (standard edition).
config_version=5

[application]
config/name="WW3 Command"
run/main_scene="res://scenes/command.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="ww3-godot"

[display]
window/size/viewport_width=1280
window/size/viewport_height=860
window/size/window_width_override=1280
window/size/window_height_override=860
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.047, 0.071, 0.102, 1)
